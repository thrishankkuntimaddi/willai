# AI provider (one of these; Gemini has a free tier at aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_API_KEY=

# Job store. Supabase → Project settings → Database → Connection string (URI, transaction pooler, port 6543).
# Leave empty to use an embedded database in ./cache/pg (fine for local development).
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Optional job aggregators (free keys). Each is skipped when its key is missing.
# ADZUNA_APP_ID=          # developer.adzuna.com
# ADZUNA_APP_KEY=
# JOOBLE_KEY=             # jooble.org/api/about
# USAJOBS_KEY=            # developer.usajobs.gov
# USAJOBS_EMAIL=          # the email you registered with USAJobs (their API requires it)
# REED_KEY=               # reed.co.uk/developers

FIREBASE_PROJECT_ID=willai-564c9

# Rate limits (per hour; counted in the database). Defaults shown.
# ADVISE_PER_HOUR=3            # signed out, or email not confirmed (per address)
# ADVISE_PER_HOUR_USER=12      # confirmed accounts
# ADVISE_PER_HOUR_IP=30        # any address, however many accounts sign in from it
# ADVISE_PER_HOUR_TOTAL=300    # whole site: caps the AI bill
# LIVE_PER_HOUR_USER=40 / LIVE_PER_HOUR_IP=60 / LIVE_PER_HOUR_TOTAL=300   # live searches of outside job sites (signed-in only)
# RECOMMEND_PER_HOUR_IP=120 / POSTS_PER_HOUR_IP=10
# Client address: proxies in front of the server (Render = 1), or a header your proxy sets itself.
# TRUST_PROXY_HOPS=1
# CLIENT_IP_HEADER=true-client-ip
