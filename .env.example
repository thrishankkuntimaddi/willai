# AI provider (one of these; Gemini has a free tier at aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# ANTHROPIC_API_KEY=

# Job store. Supabase → Project settings → Database → Connection string (URI, transaction pooler, port 6543).
# Leave empty to use an embedded database in ./cache/pg (fine for local development).
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Optional job aggregators (free keys). Each is skipped when its key is missing.
# ADZUNA_APP_ID=          # developer.adzuna.com
# ADZUNA_APP_KEY=
# JOOBLE_KEY=             # jooble.org/api/about
# USAJOBS_KEY=            # developer.usajobs.gov
# USAJOBS_EMAIL=          # the email you registered with USAJobs (their API requires it)
# REED_KEY=               # reed.co.uk/developers

FIREBASE_PROJECT_ID=willai-564c9
